#include "region.h"

LR_IROM __IROM_BASE __IROM_SIZE
{
    ER_IROM __IROM_BASE __IROM_SIZE {
        *.o (RESET, +First)

        *(InRoot$$Sections)

        .ANY (+RO)
    }

    RW_IRAM1 __RAM1_BASE (__RAM1_SIZE - __HEAP_SIZE - __STACK_SIZE)  {
        .ANY (+RW +ZI)
    }

#if __HEAP_SIZE > 0
    ARM_LIB_HEAP AlignExpr(+0, 8) __HEAP_SIZE
    {
        *(.freertos_heap)
    }
#endif

#if __STACK_SIZE > 0
    ARM_LIB_STACK __RAM1_END EMPTY -__STACK_SIZE
    {
    }
#endif

    RW_IRAM2 __RAM2_BASE __RAM2_SIZE {
        *(.ram2_data*)
    }
}